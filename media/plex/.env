# Timezone
TZ=Europe/Madrid

# User / group IDs for the container process
PUID=1000
PGID=1000

# Plex claim token (get yours at https://plex.tv/claim)
PLEX_CLAIM=

# IP advertised for remote access (e.g. http://192.168.1.100:32400)
ADVERTISE_IP=https://plex.calavia.org

# Paths
PLEX_CONFIG_PATH=/share/Container/pms-config
PLEX_TRANSCODE_PATH=/share/Multimedia/Transcode
MEDIA_PATH=/share/Multimedia

# Resource limits
PLEX_CPU_LIMIT=2
PLEX_MEM_LIMIT=8G
